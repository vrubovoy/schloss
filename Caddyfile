:80 {
	root * /srv
	encode gzip zstd

	@authCallback path /auth/callback*
	handle @authCallback {
		try_files {path} /index.html
		file_server
	}

	handle /auth/* {
		# X-Schlussel-Frontend marks a request as genuinely same-origin to
		# schlussel's own hosted frontend (see the isTrustedOrigin gate in
		# schlussel's src/routes/auth.ts) - without stripping it here, a
		# client could set it directly on a request through this proxy and
		# have it forwarded unchanged, since reverse_proxy otherwise passes
		# through whatever headers the client sent.
		reverse_proxy schlussel:4000 {
			header_up -X-Schlussel-Frontend
		}
	}

	# handle_path (not handle, unlike /auth/* above) - Wächter's own
	# routes aren't prefixed with /wachter (they're plain /health,
	# /stats, ...), so the prefix must be stripped before proxying,
	# same shape as herold-frontend's own /backend/* -> herold-backend
	# proxy.
	handle_path /wachter/* {
		reverse_proxy wachter:3007
	}

	handle {
		try_files {path} /index.html
		file_server
	}

	# Scoped to /assets/* (Vite's hashed build output), not by extension -
	# root-level static files like /favicon.svg are NOT content-hashed, so
	# caching them "immutable" for a year would hide any future change from
	# returning visitors for that long.
	@static path /assets/*
	header @static Cache-Control "public, immutable, max-age=31536000"
}
