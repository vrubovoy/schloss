# Hosted auth frontend used for login/account navigation and the /theme API.
VITE_SCHLUSSEL_URL=http://localhost:4001
SCHLUSSEL_WEB_URL=https://auth.example.com

# Dev-only Vite proxy target for same-origin /auth API requests.
SCHLUSSEL_API_URL=http://localhost:4000

# Dev-only Vite proxy target for same-origin /wachter API requests
# (the admin-only server-resources widget on the home page). Wächter
# has no VITE_*_URL of its own - it's not a separate site, its data is
# fetched same-origin through this proxy (see vite.config.ts).
WACHTER_API_URL=http://localhost:3007
